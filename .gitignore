# 工作区根仓库 · 忽略规则
#
# 背景：本工作区根目录现在是一个单一 Git 仓库（各模块已不再是独立仓库），
# 因此本文件对整个目录树生效。spaceclaim/ 与 fluent_meshing/ 下原有的
# .gitignore 仍在各自子树内继续生效，两者不冲突。
#
# 原则：只入库源码、文档、配置说明与小型输入；
#       运行产物、依赖、备份、大体积数据一律不入库。
# 体积参考（写入本文件时实测）：全树 7.1 GB / 212,367 个文件。

# ---------------------------------------------------------------
# 一、运行记录、失败产物与生成物
# ---------------------------------------------------------------
# 高保真在 data_lib/runs/high/，低保真在 data_lib/runs/low/。
# 运行产物不入库；各层 README 入库，用来固定目录契约。
/data_lib/runs/*
!/data_lib/runs/README.md
!/data_lib/runs/high/
!/data_lib/runs/low/
/data_lib/runs/high/*
!/data_lib/runs/high/README.md
/data_lib/runs/low/*
!/data_lib/runs/low/README.md
# 点云文件不入库；说明文件入库。点数和文件格式仍待定。
/data_lib/datasets/point_clouds/*
!/data_lib/datasets/point_clouds/README.md
# DATCOM 批量算例结果（每算例一个子目录：for005/for006/for022、CSV、几何核对图）
/data_lib/datcom_data/
# 运行期支撑数据
/data_lib/runtime/
# 由 scripts/run.ps1 index 生成，可随时重建
/data_lib/index.json
# SQLite 库入库（唯一真相源），但 WAL 附属文件是运行期临时物，不入库
/data_lib/datasets/SQLite/*-wal
/data_lib/datasets/SQLite/*-shm
/data_lib/datasets/SQLite/*-journal
# 失败产物异常包（约 10 MB）；只保留说明文件，索引仍可查到磁盘上的包
/feedback/*
!/feedback/README.md

# ---------------------------------------------------------------
# 二、历史大文件（迁移前的模型与网格，约 1 GB）
#     迁移清单 data_lib/legacy/migration-manifest.json 保留入库，
#     因为 README 依赖它解释旧路径。
# ---------------------------------------------------------------
/data_lib/legacy/fluent_meshing/

# ---------------------------------------------------------------
# 三、备份与受保护目录
# ---------------------------------------------------------------
# 完整备份快照（约 2.7 GB / 13.1 万个文件），回退时用 scripts/rollback.ps1
/archive/

# ---------------------------------------------------------------
# 四、依赖
#     体积大且可重装；实际版本记录见 docx/dependency-inventory.json。
#     fluent_meshing 的 _deps 与 .mesh_inspect_deps* 是互不相容的两套环境，
#     两者都不入库，避免在仓库里被误合并。
# ---------------------------------------------------------------
node_modules/
_deps/
.mesh_inspect_deps/
.mesh_inspect_deps_313/

# ---------------------------------------------------------------
# 五、Python 缓存与本机解释器配置
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/
.python-path
.mesh-inspect-python

# ---------------------------------------------------------------
# 六、本机编辑器配置
#     含机器绝对路径，按 AGENTS.md「安装路径不进源码与报告」不入库。
# ---------------------------------------------------------------
.vscode/settings.json
**/.vscode/settings.json

# ---------------------------------------------------------------
# 七、ANSYS 运行产物（在已忽略目录之外出现时兜底）
#     例外：data_lib/inputs 下记录的输入几何属于需要入库的输入。
# ---------------------------------------------------------------
*.scdoc
*.scdocx
*.msh
*.msh.h5
*.cas
*.cas.h5
*.dat
*.dat.h5
*.trn
*.jou
*.log
!data_lib/inputs/**/*.scdoc

# ---------------------------------------------------------------
# 八、大体积重数据
# ---------------------------------------------------------------
# 研究项目的基准数据（约 110 MB）；同一项目的 src/ 与 assets/ 仍入库
/experiments/autoCFD/Benchmark/
# 参考文献 PDF（约 53 MB / 11 个）。如需随仓库保存，删掉下面一行即可。
/docx/reference_papers/
# 打包备份与压缩包一律不入库：体积不可控，而已压缩的包 git 无法有效缩减。
# archive.zip（2.05 GB）就是踩过这个坑：提交进去后 push 只能干等，GitHub 还会拒收。
# 备份包放 /archive/ 下（已被忽略），或放仓库外。
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# ---------------------------------------------------------------
# 九、系统与临时文件
# ---------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
*.tmp
*.bak
*.orig
*~
# macOS 拷贝到 Windows/网络盘时留下的 AppleDouble 附属文件（如 ._datcom.exe），不是内容
._*

# ---------------------------------------------------------------
# 十、DATCOM 入库
#     程序、模板和 datcom.exe 属于本仓库。
#     上文的 *.dat、*.log、字节码等规则不覆盖 /DATCOM/。
#     算例结果仍在 data_lib/runs/low/ 与 data_lib/datcom_data/，那些目录继续忽略。
# ---------------------------------------------------------------
!/DATCOM/
!/DATCOM/**
# 上面两行放行整个 DATCOM 子树，会把字节码缓存、本机编辑器配置和 macOS 元数据
# 一起放进来（曾因此入库 8 个 .pyc、两个含本机绝对路径的 .vscode/settings.json
# 和一个 1.9 MB 的 ._cache_datcom.exe）。
# 下面几行按路径重新排除；顺序不能调整，必须留在上面两条 ! 之下才生效。
/DATCOM/**/__pycache__/
/DATCOM/**/__pycache__/**
/DATCOM/**/*.py[cod]
/DATCOM/**/.pytest_cache/
/DATCOM/**/.vscode/settings.json
/DATCOM/**/._*
